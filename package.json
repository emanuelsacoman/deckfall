{
  "name": "card-game",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:gameplay": "tsc -p shared/gameplay/tsconfig.json",
    "typecheck:gameplay": "tsc -p shared/gameplay/tsconfig.type-tests.json",
    "test:gameplay": "npm run build:gameplay && npm run typecheck:gameplay && node --test tests/gameplay/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-cardgame \"node --test tests/rules/cardgame.rules.test.mjs\"",
    "build:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "test:functions:emulator": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-cardgame \"npm --prefix functions run test:integration\"",
    "emulators:start": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,storage,functions --project demo-cardgame",
    "setup": "node setup-structure.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "firebase": "^10.14.1",
    "konva": "10.7.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
