rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      let profile = request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      return request.auth != null
        && profile.get('role', '') == 'admin' && profile.get('roleId', '') == 'admin';
    }

    function hasValidAccount() {
      let profile = request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      return request.auth != null && profile.get('role', '') in ['member', 'admin']
        && profile.get('role', '') == profile.get('roleId', '');
    }

    function collectionOwnerExists(uid) {
      return uid.matches('^[a-zA-Z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/users/$(uid));
    }

    function publishedCardExists(cardId) {
      return cardId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/cards/$(cardId))
        && get(/databases/$(database)/documents/cards/$(cardId)).data.status == 'published';
    }

    function validCollectionEntry(data) {
      // Limite técnico de propriedade, sem relação com regras futuras de decks.
      return data.keys().hasAll(['quantity', 'firstAcquiredAt', 'lastAcquiredAt'])
        && data.keys().hasOnly(['quantity', 'firstAcquiredAt', 'lastAcquiredAt'])
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 9999
        && data.firstAcquiredAt is timestamp && data.lastAcquiredAt is timestamp;
    }

    function validPackDefinition(data, packId) {
      return packId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.keys().hasAll(['name', 'description', 'active', 'currentVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'active', 'currentVersion', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        // RE2 \s é ASCII; a classe explícita acompanha whitespace do domínio JS.
        && (packId == 'starter' ? data.name == 'StarterPack'
          : data.name.lower().replace('[\\s\\x{000B}\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}_-]', '') != 'starterpack')
        && data.description is string && data.description.size() <= 1000
        && data.active is bool
        && data.currentVersion is int && data.currentVersion >= 1 && data.currentVersion <= 1000000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPackDefinitionVersion(data, version) {
      // O envelope é validado nas Rules; o backend revalida TODOS os itens,
      // IDs, quantidade máxima 9999, duplicatas e status published das cartas.
      return data.keys().hasAll(['version', 'cards', 'createdAt'])
        && data.keys().hasOnly(['version', 'cards', 'createdAt'])
        && data.version is int && data.version >= 1 && data.version <= 1000000
        && version == string(data.version)
        && data.cards is list && data.cards.size() >= 1 && data.cards.size() <= 25
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function validAttribute(attribute) {
      let value = attribute.value;
      let minimum = attribute.get('min', 0);
      let maximum = attribute.get('max', 100);
      // Limites numéricos são garantidos no servidor. Chaves, rótulos, IDs e
      // metadados visuais são validados pelo cliente antes de qualquer gravação.
      return minimum >= -1000000 && maximum <= 1000000 && minimum < maximum
        && value is number && value >= minimum && value <= maximum;
    }

    // Rules não possuem loops; oito posições mantêm a validação dentro do orçamento.
    function validAttributes(attributes) {
      let size = attributes.size();
      return attributes is list && size <= 8
        && (size < 1 || validAttribute(attributes[0])) && (size < 2 || validAttribute(attributes[1]))
        && (size < 3 || validAttribute(attributes[2])) && (size < 4 || validAttribute(attributes[3]))
        && (size < 5 || validAttribute(attributes[4])) && (size < 6 || validAttribute(attributes[5]))
        && (size < 7 || validAttribute(attributes[6])) && (size < 8 || validAttribute(attributes[7]));
    }

    function validArt(art, cardId) {
      return art == null || (art.keys().hasOnly(['storagePath', 'fileName', 'contentType', 'size'])
        && art.storagePath is string
        && art.storagePath.matches('^cards/' + cardId + '/(art|assets)/[a-zA-Z0-9_-]+[.](jpg|png|webp)$')
        && art.fileName is string && art.fileName.size() > 0 && art.fileName.size() <= 255
        && art.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && art.size is int && art.size > 0 && art.size <= 5 * 1024 * 1024);
    }

    // O conteúdo profundo é validado pelo cliente tipado; Rules limitam o envelope.
    function validCanvas(canvas) {
      let width = canvas.width;
      let height = canvas.height;
      let elements = canvas.elements;
      let assets = canvas.assets;
      return canvas is map
        && canvas.version == 1
        && width is number && width >= 160 && width <= 2048
        && height is number && height >= 160 && height <= 2048
        && canvas.background is map
        && elements is list && elements.size() <= 64
        && assets is list && assets.size() <= 24;
    }

    function validCard(data, cardId) {
      return cardId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.keys().hasOnly(['name', 'slug', 'description', 'rarity', 'status', 'art', 'attributes', 'setId', 'type', 'subtype', 'templateId', 'canvas', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0
        && data.slug is string
        && data.description is string
        && data.rarity in ['common', 'rare', 'epic', 'legendary']
        && data.status in ['draft', 'published', 'archived']
        && validArt(data.art, cardId) && validAttributes(data.attributes)
        && (!data.keys().hasAny(['canvas']) || validCanvas(data.canvas))
        && (data.setId == null || (data.setId is string && data.setId.size() > 0 && data.setId.size() <= 128))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validTemplate(data, templateId) {
      return templateId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.keys().hasOnly(['name', 'canvas', 'attributes', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && validCanvas(data.canvas) && validAttributes(data.attributes)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validUser(data, uid) {
      return uid.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.keys().hasAll(['displayName', 'contactEmail', 'role', 'roleId', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'contactEmail', 'role', 'roleId', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.size() <= 120
        && data.contactEmail is string && data.contactEmail.size() <= 254
        && (data.contactEmail == '' || data.contactEmail.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
        && data.role in ['admin', 'member'] && data.roleId == data.role
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      // Cadastro público só cria o próprio perfil member; primeiro admin via Console.
      allow create: if (isAdmin() || (request.auth != null && request.auth.uid == uid
          && request.resource.data.role == 'member' && request.resource.data.roleId == 'member'
          && request.auth.token.email is string && request.resource.data.contactEmail == request.auth.token.email))
        && validUser(request.resource.data, uid)
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validUser(request.resource.data, uid)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && (request.auth.uid != uid || request.resource.data.role == 'admin');
      allow delete: if false;

      match /collection/{cardId} {
        allow get, list: if collectionOwnerExists(uid)
          && (isAdmin() || (request.auth != null && request.auth.uid == uid && hasValidAccount()));
        allow create: if isAdmin() && collectionOwnerExists(uid) && publishedCardExists(cardId)
          && validCollectionEntry(request.resource.data)
          && request.resource.data.firstAcquiredAt == request.time
          && request.resource.data.lastAcquiredAt == request.time;
        allow update: if isAdmin() && collectionOwnerExists(uid) && publishedCardExists(cardId)
          && validCollectionEntry(request.resource.data)
          && request.resource.data.firstAcquiredAt == resource.data.firstAcquiredAt
          && request.resource.data.lastAcquiredAt == request.time;
        // Remover propriedade não depende da disponibilidade da carta global.
        allow delete: if isAdmin();
      }

      match /packs/{packInstanceId} {
        allow get, list: if collectionOwnerExists(uid)
          && (isAdmin() || (request.auth != null && request.auth.uid == uid && hasValidAccount()));
        // Packs, abertura e resultado são propriedade decidida pelo backend.
        // Não existe exceção para um cliente administrativo.
        allow create, update, delete: if false;
      }
    }

    match /players/{uid} {
      allow get: if hasValidAccount() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Apenas o backend confiável (Admin SDK) grava estado e marcador do starter.
      // Nem um cliente administrativo pode resetar ou conceder novamente.
      allow create, update, delete: if false;
    }

    match /packDefinitions/{packId} {
      // Somente administração lê a configuração; jogadores leem suas instâncias.
      allow get, list: if isAdmin();
      allow create: if isAdmin() && validPackDefinition(request.resource.data, packId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validPackDefinition(request.resource.data, packId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      // Preservar definições e versões referidas por instâncias históricas.
      allow delete: if false;

      match /versions/{version} {
        allow get, list: if isAdmin();
        allow create: if isAdmin() && packId.matches('^[a-zA-Z0-9_-]{1,128}$')
          // Aceita definição e primeira versão no mesmo commit atômico.
          && existsAfter(/databases/$(database)/documents/packDefinitions/$(packId))
          && validPackDefinitionVersion(request.resource.data, version);
        // Todas as versões são imutáveis pelo SDK cliente, inclusive admin.
        // Console e Admin SDK ignoram Rules; o backend revalida o conteúdo.
        allow update, delete: if false;
      }
    }

    match /cards/{cardId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && validCard(request.resource.data, cardId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validCard(request.resource.data, cardId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /cardTemplates/{templateId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validTemplate(request.resource.data, templateId)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validTemplate(request.resource.data, templateId)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
